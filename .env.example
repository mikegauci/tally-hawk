OPENAI_API_KEY=
# Optional overrides
# TALLYHAWK_MODEL=gpt-5.5
# TALLYHAWK_EFFORT=medium
# USD per million tokens for the model above, for cost per invoice in eval reports.
# gpt-5.5 list prices as of 2026-10 (third-party listings; check https://openai.com/api/pricing/):
TALLYHAWK_PRICE_INPUT_PER_MTOK=5
TALLYHAWK_PRICE_OUTPUT_PER_MTOK=30
# Reasoning effort for the PO-finding agent (default low)
# TALLYHAWK_AGENT_EFFORT=low

# --- API service (uvicorn tallyhawk.api:app) ---
# Postgres connection string. For Supabase use the pooler string from Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tallyhawk
# Bearer token clients must send (Authorization: Bearer ...). Leave empty only on your own machine.
TALLYHAWK_API_KEY=
# Uploaded files: Supabase Storage when both are set (service role key: server side only, never in a browser)...
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# ...otherwise a local folder
# TALLYHAWK_STORAGE_DIR=storage
# agent = the LLM looks for missing POs; rules = no LLM in matching. llm / template email drafts.
# TALLYHAWK_RESOLVER=agent
# TALLYHAWK_DRAFTER=llm
# Comma-separated browser origins allowed to call the API (the Next.js app)
# TALLYHAWK_CORS_ORIGINS=http://localhost:3000

# --- Optional Langfuse tracing (extract, agent, draft) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Demo showcase (uv run tallyhawk demo load) ---
# Requires DATABASE_URL, OPENAI_API_KEY, and TALLYHAWK_STORAGE_DIR or Supabase storage vars.

# Tests against Postgres (skipped when unset); each run creates and drops its own database
# TALLYHAWK_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
